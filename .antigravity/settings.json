{
  "compactThresholdPercent": 50,
  "maxBashOutputChars": 15000,
  "permissions": {
    "deny": [
      "Read(./**/build/**)",
      "Read(./**/.dart_tool/**)",
      "Read(./**/android/.gradle/**)",
      "Read(./**/ios/Pods/**)",
      "Read(./**/ios/.symlinks/**)",
      "Read(./**/*.sqlite*)",
      "Read(./**/*.log)",
      "Read(./**/.env*)",
      "Read(./**/auth.json)"
    ]
  }
}
